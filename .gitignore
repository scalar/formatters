# dependencies (bun install)
node_modules

# build output
target
out
dist
*.tgz
tmp

# logs
logs
*.log

# caches
.cache
*.tsbuildinfo

# lockfiles from other package managers - this repo uses bun
package-lock.json
pnpm-lock.yaml
yarn.lock

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Agent worktrees (Claude Code background agents)
.claude/worktrees/

# native-image build scratch (Oracle GraalVM, Binaryen, the gjf jar)
build/java_fmt/toolchain/
build/java_fmt/classes/
build/java_fmt/*.wasm
build/java_fmt/*.wat

# upstream TeaVM checkout that build/teavm/apply.sh patches and builds
build/teavm/toolchain/
# teavm build scratch (patched TeaVM checkout, gjf sources/jars, Binaryen)
build/java_fmt_teavm/toolchain/
build/java_fmt_teavm/target/
build/java_fmt_teavm/*.wasm
# Emitted next to every module for diagnosis; not evidence of anything, and the
# committed artifact is the module itself.
*.wasm-deobfuscator.wasm
__pycache__/
# dotnet wasm build scratch (the SDK, the wasm-tools workload, the publish tree)
build/csharp_fmt/toolchain/
build/csharp_fmt/work/

# swift build scratch (Swift toolchain, the wasm SDK, Binaryen, swift-format)
#
# `swift-format` has no trailing slash on purpose: build.sh clones it, but it is
# convenient to point it at a local checkout with a symlink, and a directory
# pattern would not match one.
build/swift_fmt/toolchain/
build/swift_fmt/swift-format
build/swift_fmt/.build/
build/swift_fmt/Package.resolved
build/swift_fmt/*.wasm

# rustfmt build scratch (the rust-lang/rust checkout build.sh clones)
#
# `rust` has no trailing slash on purpose, matching swift-format above: build.sh
# clones it, but pointing it at a local checkout with a symlink is convenient
# and a directory pattern would not match one.
build/rust_fmt/rust
build/rust_fmt/*.wasm

# rbcop build scratch (the rbcop checkout, wasi-sdk, the cargo target)
#
# `rbcop` has no trailing slash on purpose, matching rust_fmt above.
build/rbcop_fmt/rbcop
build/rbcop_fmt/toolchain/
build/rbcop_fmt/*.wasm

# ktrs build scratch (the ktrs checkout, the uncompressed module, the ktfmt jar
# the conformance test compares against)
#
# `ktrs` has no trailing slash on purpose, matching rust_fmt above.
build/kotlin_fmt/ktrs
build/kotlin_fmt/work/
build/kotlin_fmt/*.wasm
