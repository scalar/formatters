From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: amritk <amrit.kahlon00@gmail.com>
Date: Mon, 9 Nov 2026 23:45:20 +0000
Subject: [PATCH 20/20] wasm gc: reset depthBeforeLastInstructionOut when
 br_on_null meets an empty stack

---
 .../teavm/backend/wasm/model/instruction/WasmTypeInference.java | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/src/main/java/org/teavm/backend/wasm/model/instruction/WasmTypeInference.java b/core/src/main/java/org/teavm/backend/wasm/model/instruction/WasmTypeInference.java
index edeac497c..d304fa17e 100644
--- a/core/src/main/java/org/teavm/backend/wasm/model/instruction/WasmTypeInference.java
+++ b/core/src/main/java/org/teavm/backend/wasm/model/instruction/WasmTypeInference.java
@@ -85,6 +85,8 @@ public class WasmTypeInference implements WasmInstructionVisitor {
             if (ref.isNullable()) {
                 typeStack.set(typeStack.size() - 1, ref.asNonNull());
             }
+        } else {
+            depthBeforeLastInstructionOut = 0;
         }
     }
 
