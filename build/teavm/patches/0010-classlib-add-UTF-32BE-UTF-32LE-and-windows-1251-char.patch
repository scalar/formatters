+package org.teavm.classlib.java.nio.charset;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import java.nio.charset.Charset;
+import org.junit.jupiter.api.Test;
+import org.teavm.junit.TeaVMTest;
+
+@TeaVMTest
+public class UTF32Test {
+    private static final String TEXT = "a\uD83D\uDE00";
+
+    @Test
+    public void bigEndian() {
+        var charset = Charset.forName("UTF-32BE");
+        var bytes = new byte[] { 0, 0, 0, 0x61, 0, 1, (byte) 0xF6, 0 };
+        assertArrayEquals(bytes, TEXT.getBytes(charset));
+        assertEquals(TEXT, new String(bytes, charset));
+    }
+
+    @Test
+    public void littleEndian() {
+        var charset = Charset.forName("UTF-32LE");
+        var bytes = new byte[] { 0x61, 0, 0, 0, 0, (byte) 0xF6, 1, 0 };
+        assertArrayEquals(bytes, TEXT.getBytes(charset));
+        assertEquals(TEXT, new String(bytes, charset));
+    }
+}
