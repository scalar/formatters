+@TeaVMTest
+public class Windows1251Test {
+    @Test
+    public void forName() {
+        assertEquals("windows-1251", Charset.forName("windows-1251").name());
+        assertEquals("windows-1251", Charset.forName("WINDOWS-1251").name());
+    }
+
+    @Test
+    public void roundTrip() {
+        var charset = Charset.forName("windows-1251");
+        var bytes = new byte[] { (byte) 0xCF, (byte) 0xF0, (byte) 0xE8, (byte) 0xE2, (byte) 0xE5, (byte) 0xF2, 0x21 };
+        assertArrayEquals(bytes, "\u041F\u0440\u0438\u0432\u0435\u0442!".getBytes(charset));
+        assertEquals("\u041F\u0440\u0438\u0432\u0435\u0442!", new String(bytes, charset));
+    }
