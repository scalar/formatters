--- a/classlib/src/main/java/org/teavm/classlib/java/util/concurrent/TConcurrentHashMap.java
+++ b/classlib/src/main/java/org/teavm/classlib/java/util/concurrent/TConcurrentHashMap.java
@@ -636,6 +636,72 @@ public class TConcurrentHashMap<K, V> extends TAbstractMap<K, V>
         return elementCount == 0;
