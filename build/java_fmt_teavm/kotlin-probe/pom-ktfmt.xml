<?xml version="1.0" encoding="UTF-8"?>
<!--
  ktfmt to wasm. Needs ./stubs.sh and ./ktfmt.sh run first.

  It depends on local.ktfmt:ktfmt-patched rather than com.facebook:ktfmt because
  Parser has to come off KotlinCoreEnvironment - see ../patches/ktfmt.patch, and
  gate2.sh for the evidence that the swap changes no output. Installing it by
  hand means the transitive dependencies do not come with it, so they are listed
  here at the versions ktfmt 0.64 resolves.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>local.ktfmt</groupId><artifactId>probe</artifactId><version>1</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source><maven.compiler.target>21</maven.compiler.target>
    <teavm.version>0.16.0-forkthree</teavm.version>
    <ktfmt.version>0.64</ktfmt.version>
    <kotlin.version>2.3.20</kotlin.version>
    <buildDirectory>${project.basedir}/target-ktfmt</buildDirectory>
  </properties>
  <dependencies>
    <dependency><groupId>local.ktfmt</groupId><artifactId>kotlin-stubs</artifactId><version>1</version></dependency>
    <dependency><groupId>local.ktfmt</groupId><artifactId>kotlin-policy</artifactId><version>1</version></dependency>
    <dependency><groupId>local.ktfmt</groupId><artifactId>ktfmt-patched</artifactId><version>${ktfmt.version}</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso-apis</artifactId><version>${teavm.version}</version></dependency>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-compiler-embeddable</artifactId><version>${kotlin.version}</version></dependency>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency>
    <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.10.2</version></dependency>
    <!-- ktfmt lays its output out with google-java-format's Doc machinery. -->
    <dependency><groupId>com.google.googlejavaformat</groupId><artifactId>google-java-format</artifactId><version>1.23.0</version></dependency>
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.5.0-jre</version></dependency>
  </dependencies>
  <build><directory>${buildDirectory}</directory><sourceDirectory>src/ktfmt/java</sourceDirectory><plugins>
    <plugin><groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>${teavm.version}</version>
      <executions><execution><phase>package</phase><goals><goal>compile</goal></goals>
        <configuration>
          <targetDirectory>${project.build.directory}/wasm</targetDirectory>
          <targetType>WEBASSEMBLY_GC</targetType>
          <mainClass>kfmt.KtFmt</mainClass>
          <optimizationLevel>ADVANCED</optimizationLevel>
          <strict>true</strict>
          <stopOnErrors>false</stopOnErrors>
        </configuration>
      </execution>
        <execution><id>runtime</id><phase>package</phase><goals><goal>copy-webassembly-gc-runtime</goal></goals>
          <configuration><targetDirectory>${project.build.directory}/wasm</targetDirectory><modular>true</modular><deobfuscator>true</deobfuscator></configuration></execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
